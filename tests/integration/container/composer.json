{
    "name": "test/console-integration-container",
    "description": "Integration test project for console container functionality",
    "require": {
        "sanmai/console": "*",
        "sanmai/di-container": "^0.1 || ^0.2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../../../"
        }
    ],
    "autoload": {
        "psr-4": {
            "TestContainerApp\\": "src/"
        }
    },
    "extra": {
        "console": {
            "container": "DIContainer\\Container"
        }
    }
}
